load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

# github-mcp-server-rs binary (issue #9 Phase 2 で吸収)。
# rust-alc-api の binaries-like crate (carins-api / tenko-api / etc.) と同 pattern。
#
# crate_name は cargo の `[[bin]] name` (= `github-mcp-server-rs`) を維持。
# 旧 repo の release asset 名と互換性を保つため改名しないこと。

rust_binary(
    name = "github-mcp-server-rs",
    srcs = glob(["src/**/*.rs"]),
    deps = all_crate_deps(normal = True) + [
        "//crates/mcp-relay",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    edition = "2021",
    visibility = ["//visibility:public"],
)

# `build.rs` 由来の version embed 情報 (`BUILD_RELEASE_TAG` 等) は cargo 経路でのみ
# 適用される。Bazel は build script を別経路で扱うため、必要なら `cargo_build_script`
# rule で wrapping するが、今は dev/CI build としては不要なので未対応。
# Phase 2 follow-up: release artifact を Bazel で作る時に対応する。

rust_test(
    name = "github-mcp-server-rs_test",
    srcs = glob(["src/**/*.rs"]) + glob(["tests/**/*.rs"]),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/mcp-relay",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    edition = "2021",
)
